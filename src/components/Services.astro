---
import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale).services;

// Iconos en el mismo orden que t.items
const icons = [
  'M3 5h18v12H3zM8 21h8M12 17v4',
  'M6 6h15l-1.5 9h-12zM6 6 5 3H2M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm9 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z',
  'M13 2 3 14h9l-1 8 10-12h-9z',
  'm8 9-4 3 4 3m8-6 4 3-4 3M14 5l-4 14',
  'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zm10 2-4.35-4.35',
  'M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z',
];
---
<section id="services" class="py-24">
  <div class="container-lb">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title">{t.title}</h2>
      <p class="mt-4 text-zinc-400">{t.subtitle}</p>
    </div>

    <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {t.items.map((s, i) => (
        <article class="card reveal group transition hover:-translate-y-1 hover:border-brand-400/40">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-400/10 text-brand-400 transition group-hover:bg-brand-400 group-hover:text-ink-950">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={icons[i]} /></svg>
          </div>
          <h3 class="mt-5 text-xl font-semibold">{s.title}</h3>
          <p class="mt-2 text-zinc-400">{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
