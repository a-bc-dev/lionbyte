---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="border-t border-white/5 py-12">
  <div class="container-lb flex flex-col items-center justify-between gap-6 text-sm text-zinc-500 sm:flex-row">
    <a href="/" class="flex items-center gap-2 font-display font-bold text-white">
      <Logo class="h-7 w-7" /> Lion<span class="text-brand-400">Byte</span>
    </a>
    <nav class="flex gap-6">
      <a href="/privacidad" class="hover:text-white">Privacidad</a>
      <a href="/aviso-legal" class="hover:text-white">Aviso legal</a>
      <a href="/#contacto" class="hover:text-white">Contacto</a>
    </nav>
    <p>© {year} LionByte. Todos los derechos reservados.</p>
  </div>
</footer>
