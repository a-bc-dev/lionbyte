---
// Precios orientativos: ajústalos a tu tarifa real
const plans = [
  {
    name: 'Landing',
    price: '590',
    desc: 'Perfecta para lanzar un producto o campaña.',
    features: ['1 página optimizada para conversión', 'Formulario de contacto', 'Diseño adaptado a móvil', 'SEO básico', 'Entrega en 1–2 semanas'],
  },
  {
    name: 'Corporativa',
    price: '1.290',
    desc: 'La web profesional que tu negocio merece.',
    features: ['Hasta 6 secciones', 'Diseño 100% personalizado', 'Blog o noticias autogestionable', 'SEO técnico y analítica', 'Textos legales y RGPD', '1 mes de soporte incluido'],
    featured: true,
  },
  {
    name: 'E-commerce / A medida',
    price: '2.900',
    desc: 'Tiendas online y aplicaciones con funcionalidades propias.',
    features: ['Catálogo y pasarela de pago', 'Integraciones (CRM, ERP, reservas)', 'Panel de administración', 'Rendimiento y seguridad avanzados', '3 meses de soporte incluido'],
  },
];
---
<section id="precios" class="py-24">
  <div class="container-lb">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Precios</p>
      <h2 class="section-title">Planes claros, sin letra pequeña</h2>
      <p class="mt-4 text-zinc-400">Precios orientativos sin IVA. Cada proyecto es único: te enviamos un presupuesto exacto sin compromiso.</p>
    </div>

    <div class="mt-16 grid items-start gap-6 lg:grid-cols-3">
      {plans.map((p) => (
        <article class:list={['card reveal relative flex flex-col', p.featured && 'border-brand-400/60 bg-ink-800 lg:-mt-4 lg:pb-10 shadow-2xl shadow-brand-500/10']}>
          {p.featured && <span class="absolute -top-3 left-6 rounded-full bg-brand-400 px-3 py-1 text-xs font-bold text-ink-950">Más elegido</span>}
          <h3 class="text-lg font-semibold">{p.name}</h3>
          <p class="mt-1 text-sm text-zinc-400">{p.desc}</p>
          <p class="mt-6 text-zinc-400">desde <span class="font-display text-4xl font-bold text-white">{p.price}€</span></p>
          <ul class="mt-6 space-y-3 text-sm">
            {p.features.map((f) => (
              <li class="flex gap-3">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="m5 12 5 5L20 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                {f}
              </li>
            ))}
          </ul>
          <a href="#contacto" class:list={['mt-8', p.featured ? 'btn-primary' : 'btn-ghost']}>Solicitar presupuesto</a>
        </article>
      ))}
    </div>
  </div>
</section>
