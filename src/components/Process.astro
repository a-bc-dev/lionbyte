---
import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale).process;
---
<section id="process" class="border-y border-white/5 bg-ink-900/40 py-24">
  <div class="container-lb">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title">{t.title}</h2>
    </div>

    <ol class="mt-16 grid gap-8 md:grid-cols-4">
      {t.steps.map((s, i) => (
        <li class="reveal relative" style={`transition-delay:${i * 80}ms`}>
          <span class="font-display text-5xl font-bold text-gradient">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-lg font-semibold">{s.title}</h3>
          <p class="mt-2 text-zinc-400">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
