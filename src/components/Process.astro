---
const steps = [
  { n: '01', title: 'Hablamos', text: 'Nos cuentas tu idea y objetivos. Analizamos tu sector y competencia sin coste.' },
  { n: '02', title: 'Propuesta', text: 'Recibes un presupuesto cerrado con plazos claros. Sin sorpresas.' },
  { n: '03', title: 'Diseño y desarrollo', text: 'Ves avances reales cada semana y das feedback en cada fase.' },
  { n: '04', title: 'Lanzamiento', text: 'Publicamos, medimos resultados y seguimos a tu lado para crecer.' },
];
---
<section id="proceso" class="border-y border-white/5 bg-ink-900/40 py-24">
  <div class="container-lb">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Cómo trabajamos</p>
      <h2 class="section-title">De la idea a tu web en 4 pasos</h2>
    </div>

    <ol class="mt-16 grid gap-8 md:grid-cols-4">
      {steps.map((s, i) => (
        <li class="reveal relative" style={`transition-delay:${i * 80}ms`}>
          <span class="font-display text-5xl font-bold text-gradient">{s.n}</span>
          <h3 class="mt-3 text-lg font-semibold">{s.title}</h3>
          <p class="mt-2 text-zinc-400">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
