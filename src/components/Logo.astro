  </defs>
  <rect width="64" height="64" rx="14" fill="#12151f" />
  <path d="M22 18 12 32l10 14M42 18l10 14-10 14" fill="none" stroke="url(#lb-g)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
