---
import Layout from './Layout.astro';
import { useTranslations } from '../i18n/utils';

interface Props { kind: 'privacy' | 'legal' }
const { kind } = Astro.props;
const doc = useTranslations(Astro.currentLocale)[kind];
---
<!-- PLANTILLA: rellena los datos entre [corchetes] en src/i18n/translations.ts y revísalos con un profesional -->
<Layout page={kind} title={`${doc.title} · LionByte`}>
  <main class="container-lb max-w-3xl py-20">
    <h1 class="text-4xl font-bold">{doc.title}</h1>
    <div class="mt-10 space-y-5 leading-relaxed">
      {doc.sections.map((s) => (
        <>
          <h2 class="mt-10 text-xl font-semibold">{s.h}</h2>
          <p>{s.p}</p>
        </>
      ))}
    </div>
  </main>
</Layout>
