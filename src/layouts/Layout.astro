---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLang, getLang, languages, locales, routes, useTranslations, type PageKey } from '../i18n/utils';

interface Props {
  page: PageKey;
  title?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { page, title = t.meta.title } = Astro.props;
const description = t.meta.description;

const canonical = new URL(routes[lang][page], Astro.site);
const alternates = (Object.keys(languages) as (keyof typeof languages)[]).map((l) => ({
  hreflang: locales[l],
  href: new URL(routes[l][page], Astro.site).toString(),
}));
const ogImage = new URL('/og.png', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'LionByte',
  url: Astro.site?.toString(),
  description,
  inLanguage: Object.values(locales),
  serviceType: t.services.items.map((s) => s.title),
};
---

<!doctype html>
<html lang={locales[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(routes[defaultLang][page], Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#07080c" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LionByte" />
    <meta property="og:locale" content={locales[lang].replace('-', '_')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header page={page} />
    <slot />
    <Footer />

    <script>
      const els = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
